SECRET_KEY=fimiku-dev-secret-key-replace-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==========================================
# MongoDB Atlas Configuration
# ==========================================
# Replace with your MongoDB Atlas connection string:
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fimiku_db?retryWrites=true&w=majority
MONGODB_DB_NAME=fimiku_db
DB_ENGINE=sqlite

# ==========================================
# Third-Party Integrations
# ==========================================
# Google Gemini API Key for AI Advisor
GEMINI_API_KEY=

# Razorpay Test Credentials (Leave placeholder for mock checkout)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
